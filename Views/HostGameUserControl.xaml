<UserControl  x:Class="Familiada.Views.HostGameUserControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Familiada.Converters"

        Background="Gray"
        KeyDown="Window_KeyDown">
    
     <UserControl.Resources>
        <local:PlusOneConverter x:Key="PlusOneConverter"/>
     </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pytanie -->
        <TextBlock  Grid.Row="0" FontSize="24"
                   Margin="0,0,0,10" 
                   Text="{Binding CurrentQuestionText}"/>

        <!-- Lista odpowiedzi -->
        <ItemsControl  Grid.Row="1" ItemsSource="{Binding Answers}" HorizontalAlignment="Left" Width="680" AlternationCount="100">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <!-- Numer wiersza: alternation index + 1 -->
                        <TextBlock Grid.Column="0"
                           Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}, 
                            Path=(ItemsControl.AlternationIndex), Converter={StaticResource PlusOneConverter}}"
                           FontSize="22"
                           HorizontalAlignment="Center"/>


                        <!-- Tekst odpowiedzi -->
                        <TextBlock Grid.Column="1"
                           Text="{Binding Text}"
                           FontSize="22"/>

                        <!-- Punkty -->
                        <TextBlock Grid.Column="2"
                           Text="{Binding Points}"
                           HorizontalAlignment="Right"
                           FontSize="22"/>

                        <!-- Button odkryj -->
                        <Button  Grid.Column="3" Content="Odkryj" Margin="10,0,0,0" 
                            Command="{Binding DataContext.RevealAnswerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>

                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <!-- Kto pierwszy ten lepszy -->
        <StackPanel Grid.Row="2" Margin="5">

            <TextBlock FontSize="24" Margin="5"
                Text="{Binding FirstWinsText}"/>
            
            <Button Content="CheckFirstWins"
               Width="140"
               Command="{Binding CheckFirstWinsCommand}"/>

        </StackPanel>

        <!-- Odpowiada Team -->
        <TextBlock  Grid.Row="3" FontSize="24"
                   Margin="0,0,0,10"
                   Text="{Binding TeamAnswersText}"/>

        <!-- Buttons Odpowiada Team -->
        <StackPanel Grid.Row="4"
              Orientation="Horizontal"
              HorizontalAlignment="Left"
              Margin="0,10,0,0">

            <Button Content="Drużyna A"
              Width="140"
              Command="{Binding TeamAAnsweringCommand}"/>

            <Button Content="Drużyna B"
               Width="140"
               Command="{Binding TeamBAnsweringCommand}"/>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,10,0,0">
                <Button Content="Intro Music"
            Width="140"
            Command="{Binding IntroMusicCommand}"/>
                <Button Content="Answer Correct"
            Width="140"
            Command="{Binding AnswerCorrectCommand}"/>

                <Button Content="Answer Incorrect"
            Width="140"
            Command="{Binding AnswerIncorrectCommand}"/>

                <Button Content="Next Round"
            Width="140"
            Command="{Binding TriggerNextRoundCommand}"/>

                <Button Content="TestTeamALost3Chances"
             Width="140"
             Command="{Binding TestTeamALost3Chances}"/>
        </StackPanel>
        
    </Grid>
</UserControl>
