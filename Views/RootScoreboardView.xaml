<Window x:Class="Familiada.Views.RootScoreboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Familiada.ViewModels"
        xmlns:views="clr-namespace:Familiada.Views"
        Title="Familiada" Height="{Binding ScoreboardHeight}" Width="{Binding ScoreboardWidth}"
        Left="{Binding ScoreboardOffsetX}"
        Top="{Binding ScoreboardOffsetY}"
        >


    <Window.DataContext>
        <vm:RootViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:ScoreboardGameUserControl/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FinalViewModel}">
            <views:ScoreboardFinalUserControl/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
