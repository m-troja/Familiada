<UserControl x:Class="Familiada.Views.FinalScoreboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Familiada.Converters"
        
        Background="Gray" 
        Height="720" 
        Width="1080"
        >

    <UserControl.Resources>
        <local:PlusOneConverter x:Key="PlusOneConverter"/>
        <local:BoolToVisibility x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <!-- Main Grid -->

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
           
            <!-- Pula punktów -->
            <RowDefinition Height="Auto"/>

            <!-- Nazwy drużyn -->
            <RowDefinition Height="Auto"/>

            <!-- Wartości punktów drużyn -->
            <RowDefinition Height="Auto"/>

            <!-- Final Scoreboard -->
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>

        <!-- Pula punktów (środek) -->
        <TextBlock Grid.Row="0"
               FontSize="28"
               HorizontalAlignment="Center"
               Text="{Binding RoundPoints}"/>

        <!-- Nazwy drużyn -->
        <Grid x:Name="TeamNames" Margin="0,37,0,44" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="24" HorizontalAlignment="Left" Text="{Binding TeamAPointsText}"/>
            <TextBlock Grid.Column="1" FontSize="24" HorizontalAlignment="Right" Text="{Binding TeamBPointsText}"/>
        </Grid>

        <!-- Wartości punktów drużyn -->
        <Grid x:Name="TeamPoints" Grid.Row="2" Margin="0,32,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="28" HorizontalAlignment="Left" Text="{Binding TeamAPoints}"/>
            <TextBlock Grid.Column="1" FontSize="28" HorizontalAlignment="Right" Text="{Binding TeamBPoints}"/>
        
        </Grid>


        <!-- Final Scoreboard -->
        <Grid x:Name="XandScoreboardGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Gracz1 Lista odpowiedzi -->
                <ColumnDefinition Width="*"/>
                <!-- Gracz2 Lista odpowiedzi -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Gracz1 Lista odpowiedzi -->
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding Answers}"
                          AlternationCount="100" Margin="0,13,0,0">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                         <Border BorderBrush="Red" BorderThickness="1">
                            <Grid x:Name="ScoreboardGrid" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <!-- Gracz1 Tekst -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Gracz1 Punkty -->
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Tekst -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayText}"
                                           FontSize="22"/>

                                <!-- Punkty -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayPoints}"
                                       HorizontalAlignment="Right"
                                       FontSize="22"/>

                     </Grid>
                     </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Gracz2 Lista odpowiedzi -->
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding Answers}"
                          AlternationCount="100" Margin="0,13,0,0">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Red" BorderThickness="1">
                            <Grid x:Name="ScoreboardGrid" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <!-- Gracz2 Tekst -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Gracz2 Punkty -->
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Tekst -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayText}"
                                           FontSize="22"/>

                                <!-- Punkty -->
                                <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayPoints}"
                                       HorizontalAlignment="Right"
                                       FontSize="22"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Grid>
</UserControl>