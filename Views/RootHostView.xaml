<Window x:Class="Familiada.Views.RootHostView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Familiada.ViewModels"
        xmlns:views="clr-namespace:Familiada.Views"
        Title="Host" Height="800" Width="1200">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:HostGameUserControl/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FinalViewModel}">
            <views:HostFinalUserControl/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
