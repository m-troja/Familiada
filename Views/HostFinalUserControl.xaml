<UserControl x:Class="Familiada.Views.HostFinalUserControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Familiada.Converters"
        Background="Gray"
        KeyDown="Window_KeyDown"
        >

    <UserControl.Resources>
        <local:PlusOneConverter x:Key="PlusOneConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <!-- Lista odpowiedzi all pytania-->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">

            <ItemsControl ItemsSource="{Binding AllQuestionsInFinal}">

                <!-- HORIZONTAL QUESTIONS -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- SINGLE QUESTION COLUMN -->
                        <Border Margin="8"
                        Padding="10"
                        BorderBrush="DarkGray"
                        BorderThickness="1"
                        Width="Auto">

                            <StackPanel>

                                <!-- Question text -->
                                <TextBlock Text="{Binding Text}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                                <!-- ANSWERS -->
                                <ItemsControl ItemsSource="{Binding Answers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Answer -->
                                                <TextBlock Grid.Column="0"
                                                   Text="{Binding Text}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap"/>

                                                <!-- Points -->
                                                <TextBlock Grid.Column="1"
                                                   Text="{Binding Points}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>

                                                <!-- Reveal -->
                                                <Button Grid.Column="2"
                                                Content="Reveal"
                                                Command="{Binding DataContext.RevealAnswerCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                FontSize="8"
                                                        />
                                            </Grid>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

        <!-- Scoreboard Preview text -->
        <Grid Grid.Row="1">
            <TextBlock FontSize="22" Text="{Binding RoundPointsText}"/>
        </Grid>


        <!-- Scoreboard Preview  -->
        <Border Grid.Row="2" Margin="8"
             Padding="10"
             BorderBrush="DarkGray"
             BorderThickness="1"
             Width="Auto">
         
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ItemsControl  Grid.Column="0" ItemsSource="{Binding AnswersFinalPlayer1}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,30,0">
                                <TextBlock FontSize="12" Text="{Binding Text}"/>
                                <TextBlock FontSize="12" Text="{Binding Points}"  Margin="10,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding AnswersFinalPlayer2}" >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel  HorizontalAlignment="Left" Orientation="Horizontal" Margin="30,0,0,0">
                                <TextBlock FontSize="12" Text="{Binding Points}" Margin="0,0,10,0"/>
                                <TextBlock FontSize="12" Text="{Binding Text}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>


        <!-- Text Odpowiada Gracz -->
        <TextBlock  Grid.Row="3" FontSize="25"
                   Margin="0,0,0,10"
                   Text="{Binding PlayerAnsweringText}"/>

        <!-- Button Odpowiada Gracz -->
        <StackPanel Grid.Row="4"
              Orientation="Horizontal"
              HorizontalAlignment="Left"
              Margin="0,10,0,0">

            <Button Content="Następny gracz odpowiada" Margin="5"
              Width="Auto"
              Command="{Binding TriggerNextPlayerAnsweringCommand}" />
            
            <TextBlock  FontSize="24"
                   Margin="0,0,0,10"
                   Text="{Binding FinalText}"/>

        </StackPanel>

        <!-- Timer -->
        <StackPanel Grid.Row="5"
              Orientation="Horizontal"
              HorizontalAlignment="Left"
              Margin="0,10,0,0">

            <Button Content="Start timer"  Margin="5"
              Width="100"
              Command="{Binding StartTimerCommand}" />

            <Button Content="Reset timer"  Margin="5"
              Width="100"
              Command="{Binding ResetTimerCommand}" />

            <TextBlock  FontSize="24"
                   Margin="0,0,0,10"
                   Text="{Binding TimerSeconds}"/>

        </StackPanel>

        <!-- Buttons --> 
        <StackPanel Grid.Row="6"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,10,0,0">
            
            <Button Content="Potwórzenie (spacja)" Background="OrangeRed" Width="140" 
                    Command="{Binding PlayAnswerIncorrectCommand}"> </Button>

            <Button Content="Wstaw złą odp" Background="Red" Width="140" 
                Command="{Binding InsertWrongAnswerCommand}"></Button>

            <Button Content="Reset finału" Background="CadetBlue" Width="80" Margin="10"
                Command="{Binding ResetCommand}"></Button>
            
            <Button Content="Outro" Background="Wheat" Width="80" Margin="5"
                Command="{Binding PlayOutroCommand}"></Button>
            
        </StackPanel>
        
    </Grid>
</UserControl>
