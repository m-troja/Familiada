<UserControl x:Class="Familiada.Views.ScoreboardFinalUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Familiada.Converters"
             Background="Black"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext}">

    <UserControl.Resources>
        <local:PlusOneConverter x:Key="PlusOneConverter"/>
        <local:BoolToVisibility x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <!-- Main Grid -->

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
          
            <!-- Final Scoreboard -->
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>

        <!-- Scoreboard Preview  -->
        <Border Grid.Row="0" Margin="8"
             Padding="10"
             BorderBrush="Black"
             BorderThickness="1"
             Width="Auto">

            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <ItemsControl x:Name="AnswersPlayer1ItemsControl" Grid.Column="0" ItemsSource="{Binding AnswersFinalPlayer1}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,30,0">
                                <TextBlock FontSize="32" Text="{Binding DisplayText}"  Margin="10" FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" />
                                <TextBlock FontSize="32" Text="{Binding DisplayPoints}"  Margin="10"  FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="AnswersPlayer2ItemsControl" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AnswersFinalPlayer2}" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel  HorizontalAlignment="Left" Orientation="Horizontal" Margin="30,0,0,0">
                                    <TextBlock FontSize="32" Text="{Binding DisplayPoints}" Margin="10"  FontFamily="{StaticResource FamiliadaFont}"  Foreground="Yellow" />
                                    <TextBlock FontSize="32" Text="{Binding DisplayText}"  Margin="10" FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="1" Text="{Binding TotalPointsText}" FontSize="32" HorizontalAlignment="Right" Margin="0,50,150,0"
                   FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow"  />

                    <Border Grid.Row="2" BorderBrush="Yellow" BorderThickness="2" Padding="11" CornerRadius="5" Margin="0,30,110,10" Width="260">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="44" FontFamily="{StaticResource FamiliadaFont}"
                           Margin="0,0,0,10" Foreground="Yellow"
                           Text="Czas: "/>
                            
                            <TextBlock Grid.Column="1" FontSize="44" FontFamily="{StaticResource FamiliadaFont}"
                           Margin="0,0,0,10" Foreground="Yellow"
                           Text="{Binding TimerSeconds}"/>
                            
                        </Grid>
                        

                    </Border>

                </Grid>
            </Grid>
        </Border>
        
    </Grid>
    
</UserControl>