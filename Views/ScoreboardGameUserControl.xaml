<UserControl x:Class="Familiada.Views.ScoreboardGameUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Familiada.Converters"
             Background="Gray"
             >
    <UserControl.Resources>
        <local:PlusOneConverter x:Key="PlusOneConverter"/>
        <local:BoolToVisibility x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pula punktów -->
        <TextBlock Grid.Row="0"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   Text="{Binding RoundPoints}"/>

        <!-- Nazwy drużyn -->
        <Grid x:Name="TeamNames" Margin="0,37,0,44" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="24" HorizontalAlignment="Left" Text="{Binding TeamAPointsText}"/>
            <TextBlock Grid.Column="1" FontSize="24" HorizontalAlignment="Right" Text="{Binding TeamBPointsText}"/>
        </Grid>

        <!-- Wartości punktów drużyn -->
        <Grid x:Name="TeamPoints" Grid.Row="2" Margin="0,32,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="28" HorizontalAlignment="Left" Text="{Binding TeamAPoints}"/>
            <TextBlock Grid.Column="1" FontSize="28" HorizontalAlignment="Right" Text="{Binding TeamBPoints}"/>
        </Grid>

        <!-- Grid X + Scoreboard -->
        <Grid x:Name="XandScoreboardGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <!-- X Drużyna A -->
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100"
                                   Text="{Binding TeamAX1}"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100"
                                   Text="{Binding TeamAX2}"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100"
                                   Text="{Binding TeamAX3}"/>
                    </StackPanel>
                    <TextBlock FontSize="222" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsTeamAdisplayBigX, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding TeamAbigX}"/>
                </Grid>
            </Border>

            <!-- Lista odpowiedzi -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Answers}" AlternationCount="100" Margin="0,13,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Red" BorderThickness="1">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter},
                                                  Path=(ItemsControl.AlternationIndex),
                                                  Converter={StaticResource PlusOneConverter}}"
                                           FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="22"/>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayPoints}" FontSize="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- X Drużyna B -->
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="2">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100" Text="{Binding TeamBX1}"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100" Text="{Binding TeamBX2}"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100" Text="{Binding TeamBX3}"/>
                    </StackPanel>
                    <TextBlock FontSize="222" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsTeamBdisplayBigX, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding TeamBbigX}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
