<UserControl x:Class="Familiada.Views.ScoreboardGameUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Familiada.Converters"
             Background="Black"
             >
    <UserControl.Resources>
        <local:PlusOneConverter x:Key="PlusOneConverter"/>
        <local:BoolToVisibility x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pula punktów -->
        <TextBlock Grid.Row="0"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   Text="{Binding RoundPoints}" 
                   FontFamily="{StaticResource FamiliadaFont}"

                   />

        <Grid x:Name="TeamNames"
              Margin="0,37,0,44"
              Grid.Row="1"
              >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       FontSize="{Binding FontsizeGameScoreboard}"
                       HorizontalAlignment="Left"
                       Text="{Binding Team1Name}"
                       FontFamily="{StaticResource FamiliadaFont}"
                       Foreground="Yellow"
                       />

            <TextBlock Grid.Column="1"
                       FontSize="{Binding FontsizeGameScoreboard}"
                       HorizontalAlignment="Right"
                       Text="{Binding Team2Name}"  
                       FontFamily="{StaticResource FamiliadaFont}"
                       Foreground="Yellow"
                       />
        </Grid>

        <!-- Wartości punktów drużyn -->
        <Grid x:Name="TeamPoints" Grid.Row="2" Margin="0,32,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"  FontSize="{Binding FontsizeGameScoreboard}" HorizontalAlignment="Left" Text="{Binding TeamAPoints}" FontFamily="{StaticResource FamiliadaFont}"
                       Foreground="Yellow"
                       />
            <TextBlock Grid.Column="1"  FontSize="{Binding FontsizeGameScoreboard}" HorizontalAlignment="Right" Text="{Binding TeamBPoints}" FontFamily="{StaticResource FamiliadaFont}"
                Foreground="Yellow"
                       />
        </Grid>

        <!-- Grid X + Scoreboard -->
        <Grid x:Name="XandScoreboardGrid" Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- X Drużyna A -->
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock  Margin="11" HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="{Binding FontsizeGameScoreboardX}"
                                   Text="{Binding TeamAX1}" FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" />
                        <TextBlock  Margin="11" HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="{Binding FontsizeGameScoreboardX}"
                                   Text="{Binding TeamAX2}" FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" />
                        <TextBlock  Margin="11" HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="{Binding FontsizeGameScoreboardX}"
                                   Text="{Binding TeamAX3}" FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" />
                    </StackPanel>
                    <TextBlock FontSize="211" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsTeamAdisplayBigX, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding TeamAbigX}" FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" />
                </Grid> 
            </Border>

            <!-- Lista odpowiedzi -->

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Answers}" AlternationCount="100" Margin="0,13,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="10"
                                               Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter},  Path=(ItemsControl.AlternationIndex),
                                                      Converter={StaticResource PlusOneConverter}}" FontFamily="{StaticResource FamiliadaFont}" 
                                               FontSize="{Binding DataContext.FontsizeGameScoreboard,  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               HorizontalAlignment="Center" Foreground="Yellow" 
                                               />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}"   
                                               FontSize="{Binding DataContext.FontsizeGameScoreboard,  RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                               Margin="10" Foreground="Yellow" FontFamily="{StaticResource FamiliadaFont}"
                                               />
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayPoints}"  
                                               FontSize="{Binding DataContext.FontsizeGameScoreboard, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                               HorizontalAlignment="Right" Margin="10"
                                               FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow" 
                                               />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="1" Text="{Binding TotalPointsText}"  FontSize="{Binding FontsizeGameScoreboard}" HorizontalAlignment="Right" Margin="0,50,10,0"
               FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow"  />
                
            </Grid>


            <!-- X Drużyna B -->
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="2">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Margin="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{Binding FontsizeGameScoreboardX}" Text="{Binding TeamBX1}" 
                                   FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow"/>
                        <TextBlock Margin="11" HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="{Binding FontsizeGameScoreboardX}" Text="{Binding TeamBX2}" 
                                   FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow"/>
                        <TextBlock Margin="11" HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="{Binding FontsizeGameScoreboardX}" Text="{Binding TeamBX3}" 
                                   FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow"/>
                    </StackPanel>
                    <TextBlock FontSize="211" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsTeamBdisplayBigX, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding TeamBbigX}" FontFamily="{StaticResource FamiliadaFont}" Foreground="Yellow"/>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
